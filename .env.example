# Copy to .env and fill in your real keys.

# OpenAI — used for /api/chat (gpt-4o-mini Responses API with web_search) and
# the LLM reranker in src/rerank.py. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ElevenLabs — used for /api/tts (high-quality voice reply, free tier ~10k
# chars/month). Get one at https://elevenlabs.io/app/settings/api-keys.
# Leave blank to fall back to the browser's built-in speechSynthesis voice.
ELEVENLABS_API_KEY=sk_...
